# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/dispute_portal"

# Used by docker-compose to set the postgres container password
# Must match the password in DATABASE_URL above
POSTGRES_PASSWORD=password

# ─── Backend server ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Allowed CORS origin — set to the frontend URL
CORS_ORIGIN=http://localhost:5173

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# The base URL the browser uses to reach the backend API
VITE_API_URL=http://localhost:3001
